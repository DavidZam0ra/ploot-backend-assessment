# Conexión a Postgres como app_role (RLS activo, ver db/migrations/0001_init.sql y
# db/bootstrap-roles.sql). Nunca uses el superusuario aquí: te saltarías el aislamiento de
# tenant que este servicio existe para demostrar.
DATABASE_URL=postgres://app_role:app_role_test_password@localhost:5433/ploot

# Secreto HS256 para firmar/verificar los JWT de prueba (sin IdP real, ver src/auth/jwt.ts).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
