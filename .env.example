# Variables leídas por docker-compose.yml (docker compose up). Copia a .env en la raíz.
# Para desarrollo local sin Docker, cada paquete tiene su propio .env.example
# (app/.env.example, worker/.env.example) con estos mismos valores ya puestos por defecto.

# Contraseñas de app_role/worker_role, fijadas automáticamente al crear el volumen de Postgres
# por db/docker-init-roles.sh (ver db/bootstrap-roles.sql). Cambia estos valores de ejemplo si
# publicas el puerto de Postgres fuera de tu máquina.
APP_ROLE_PASSWORD=app_role_dev_password
WORKER_ROLE_PASSWORD=worker_role_dev_password

# Secreto HS256 para firmar/verificar los JWT de prueba (sin IdP, ver app/src/auth/jwt.ts).
JWT_SECRET=dev-secret-do-not-use-in-production

# Obligatoria, sin valor por defecto en docker-compose.yml: nunca debe haber una clave de
# cifrado hardcodeada. 32 bytes en base64 (AES-256) — genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
