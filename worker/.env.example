# Conexión a Postgres como worker_role (BYPASSRLS, ver db/migrations/0001_init.sql). La
# contraseña la fija db/docker-init-roles.sh solo al crear el volumen de Postgres (ver
# APP_ROLE_PASSWORD/WORKER_ROLE_PASSWORD en el .env.example de la raíz) — usa el mismo valor
# aquí. Puerto 5433 si tienes docker-compose.override.yml por conflicto con un Postgres nativo.
DATABASE_URL=postgres://worker_role:worker_role_dev_password@localhost:5432/ploot

# URL del mock del proveedor (app/mock-provider). En docker-compose es http://provider-mock:4000.
PROVIDER_BASE_URL=http://localhost:4000

# Obligatoria, sin valor por defecto: nunca debe haber una clave de cifrado hardcodeada como
# fallback. 32 bytes en base64 (AES-256) — genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# El resto tiene defaults razonables en worker/src/main.ts — descomenta solo lo que quieras
# cambiar.
# WORKER_ID=worker-local
# CLAIM_BATCH_SIZE=20
# GLOBAL_CONCURRENCY=10
# PROFILE_CONCURRENCY=1
# MAX_ATTEMPTS=5
# BASE_BACKOFF_MS=1000
# MAX_BACKOFF_MS=30000
# POLL_INTERVAL_MS=2000
# STALE_CLAIM_AFTER_MS=60000
# STALE_SWEEP_INTERVAL_MS=30000
# RATE_LIMIT_APP_MAX=50
# RATE_LIMIT_APP_WINDOW_MS=1000
# RATE_LIMIT_PROFILE_MAX=1
# RATE_LIMIT_PROFILE_WINDOW_MS=2000
